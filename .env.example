# Sanjarbek Otabekov Portfolio — Environment Configuration

# NOTE: The portfolio features a zero-config fallback mode.
# If these variables are left empty or omitted, the application will automatically
# load rich built-in seed data and persist admin changes in your browser session.
# To connect to your live Google Firebase project, provide your credentials below:

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Site URL
NEXT_PUBLIC_SITE_URL=https://sanjarme.uz
